{
  // HOW WIDE THE QC SUITE RUNS. Read by qc/run_qc.py; one run can override
  // with --jobs N and --browsers N. Asked 2026-09-17: *can you use more than
  // that i think my pc can do it* (24 cores, 31 GB).
  //
  // Change a number only with a measurement behind it: three green full runs
  // in a row at the new width, with nothing else heavy on the machine. A red
  // gate that is really the machine being busy costs more than it saves.

  // plain checks at once (capped at the core count minus two)
  "workers": 10,

  // checks that open a headless Edge at once. Measured 2026-09-17, full suite,
  // quiet machine: 3 = 540 s, 6 = 192 s, 9 = 174 s, 12 = 303 s with a false
  // failure (too many browsers). 9 went red three gates in a row the same
  // night, a different browser check each time, all green alone, while the
  // PC was busy (gates 298 s, not 174 s). 6 keeps the margin.
  "browserLanes": 6,

  // A browser check that fails in the parallel run is run ALONE this many
  // times. All green = counted passed but printed FLAKY; any red = the
  // original failure stands and blocks. User decision 2026-09-22 (A26-93):
  // four full gates that night, main included, each red on a different
  // browser check that passed alone. 0 turns the rule off.
  "browserRetriesAlone": 2,

  // HARD LIMIT per check, seconds (qc/lib/check_pool.py). A check still running
  // past max(this, 3 x its slowest healthy time) has its process tree and its
  // browsers killed and fails with "timed out after N s", so one hung check can
  // never stall the whole run (three scheduled runs stopped at ~340/415 on
  // 2026-11-25). Generous on purpose: the slowest healthy check is ~250 s.
  "checkTimeoutFloorSecs": 600,

  // POLITE MODE (user 2026-11-26: a full QC run left the PC laggy; other programs are open
  // in real use, so leave headroom instead of stopping). QC is background work:
  //  - runner and every child (incl. Edge via PowerShell): BELOW_NORMAL CPU, LOW I/O and
  //    memory priority, in a job object with a CPU hard cap and a memory limit;
  //  - a governor samples the whole machine every ~2 s and starts no NEW check while total
  //    CPU > targetCpuPct, free RAM < reserveRamGb or the GPU is busier than 100 - gpuReservePct
  //    (one check per pool always runs), and tightens/relaxes the job's CPU cap;
  //  - workers and browser lanes leave reserveCpus logical CPUs free.
  // It never suspends or kills anything by default. Off: "polite": false or env MICE_POLITE=0
  // (the run says so). Never applied to the real hub, Voice or Faces.
  "polite": true,
  "reserveCpus": 4,
  "cpuCapPercent": null,          // null = (cores - reserveCpus) / cores
  "targetCpuPct": 75,
  "reserveRamGb": 6,
  "gpuReservePct": 30,
  "jobMemoryPct": 50,             // hard limit for the whole QC job, % of RAM
  // Optional stronger yield (off by default): "pause" stops starting checks while a foreground
  // app in yieldTo runs / you typed within idleSeconds; "freeze" also suspends running checks
  // (their own timers then jump: expect flakes). Hard time limits never count frozen time.
  "yieldMode": "none",
  "yieldTo": [],
  "yieldToInput": false,
  "idleSeconds": 20
}
