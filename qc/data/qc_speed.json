{
  // HOW WIDE THE QC SUITE RUNS. Read by qc/run_qc.py; one run can override
  // with --jobs N and --browsers N. Asked 2026-09-17: *can you use more than
  // that i think my pc can do it* (24 cores, 31 GB).
  //
  // Change a number only with a measurement behind it: three green full runs
  // in a row at the new width, with nothing else heavy on the machine. A red
  // gate that is really the machine being busy costs more than it saves.

  // plain checks at once (capped at the core count minus two)
  "workers": 10,

  // checks that open a headless Edge at once. Measured 2026-09-17, full suite,
  // quiet machine: 3 = 540 s, 6 = 192 s, 9 = 174 s, 12 = 303 s with a false
  // failure (too many browsers). 9 went red three gates in a row the same
  // night, a different browser check each time, all green alone, while the
  // PC was busy (gates 298 s, not 174 s). 6 keeps the margin.
  "browserLanes": 6,

  // A browser check that fails in the parallel run is run ALONE this many
  // times. All green = counted passed but printed FLAKY; any red = the
  // original failure stands and blocks. User decision 2026-09-22 (A26-93):
  // four full gates that night, main included, each red on a different
  // browser check that passed alone. 0 turns the rule off.
  "browserRetriesAlone": 2
}
