                 "hub-flash", "hub-show", "hub-apps", "hub-extensions", "hub-support", "hub-studio", "hub-modules"]},

    {"id": "hub-extensions", "summary": "This PC's apps as extensions (A51-2): which apps are installed here and where, add by folder (mice-app.json, app.json or a partner template), remove/restore, update; apps whose partner is missing are hidden.",
     "files": ["main_python/extensions.py", "main_python/hub_api_extensions.py",
