{
  "_why": "Which subsystem owns which file - the 'header' map of the project. Asked 2026-09-21 (A26-76): every AI reads one short header, changes one subsystem, and QC checks only that subsystem. Edit THIS file to add a system or a file; docs/systems/*.md and the index are generated from it by tools/systems.py. check_systems fails on a file nobody owns, a file two systems claim, or a stale header.",

  "exclude": [".git/", ".pio/", "__pycache__/", "node_modules/", ".vscode/", ".claude/",
              ".agents/", "dist/", "build/", "patches/", "patches_code/", "generated/",
              "tts_cache/", "reports/", "scratch/", "sequences/", "projects/", "shows/",
              "models/", "vendor/", "APPDATA/", ".staging", "firmware/lib/",
              "firmware/sd_card_example/", "scient_test/results/", ".unsnooze/",
              "docs/systems/",
              "hub_auth.json."],
  "excludeNames": ["promt.md", "PATCHES.md", "hub_auth.json", "hub_password.txt",
                   "faces_login.json", "known_hubs.json", "settings_shared.json",
                   ".qc-receipt.json", ".gitignore", "MiceHub.exe"],
  "excludeExt": [".pyc", ".bin", ".exe", ".log", ".wav", ".mp3", ".png", ".jpg",
                 ".ico", ".onnx", ".bak", ".tmp"],

  "systems": [
    {"id": "hub", "summary": "The hub program: HTTP server, routes, USB/RS485 access, flashing, show clock. Being split (A26-76 phase 2).",
     "files": ["main_python/main.py", "main_python/app_window.py", "main_python/build_stamp.py",
               "main_python/partner_launch.py", "main_python/hub_usb.py", "main_python/run_hub.*", "main_python/README.md",
               "MiceHub.spec", "requirements.txt", "config/app_window.json", "config/partners.json"],
     "depends": ["hub-auth", "hub-net", "hub-media", "hub-shows", "fw-registry"]},

    {"id": "hub-auth", "summary": "Hub logins, sessions, which pages need a login, pairing two hubs.",
     "files": ["main_python/hub_auth.py", "main_python/hub_pair.py", "config/page_access.json",
               "config/board_logins.json"],
     "depends": []},

    {"id": "hub-net", "summary": "Finding boards and other hubs on the network, mDNS names, QR codes, choosing the fastest route.",
     "files": ["main_python/discovery.py", "main_python/mdns.py", "main_python/qr.py",
               "main_python/route_latency.py", "config/route_latency.json"],
     "depends": []},

    {"id": "hub-media", "summary": "Camera relay and audio streaming to boards.",
     "files": ["main_python/cam_relay.py", "main_python/stream_audio.py"],
     "depends": []},

    {"id": "hub-shows", "summary": "Saved shows: sequences played in series by name.",
     "files": ["main_python/shows.py"],
     "depends": []},

    {"id": "hub-web", "summary": "The pages the hub serves: Home/Modules, help, login, and their patch snapshots.",
     "files": ["main_python/web/", "main_python/web_gemini/", "main_python/web_ox/",
               "main_python/save_hub_patch.py", "main_python/nong.ico"],
     "depends": ["shared-web"]},

    {"id": "shared-web", "summary": "One stylesheet and theme set for every page (mice.css, themes).",
     "files": ["shared/"],
     "depends": []},

    {"id": "studio", "summary": "Nong Studio: pose editor, timeline, 3D monitor.",
     "files": ["nong/", "apps/studio/"],
     "depends": ["shared-web"]},

    {"id": "app-voice", "summary": "Voice helper: speech in, answers, speech out.",
     "files": ["apps/voice/", "config/voice.json", "llm/"],
     "depends": []},

    {"id": "app-faces", "summary": "Face recognition app.",
     "files": ["apps/faces/", "config/faces.json"],
     "depends": []},

    {"id": "app-camera", "summary": "Camera viewer app.",
     "files": ["apps/camera/"],
     "depends": ["shared-web"]},

    {"id": "app-small", "summary": "Small apps: help, All-Jao.",
     "files": ["apps/help/", "apps/all-jao/"],
     "depends": ["shared-web"]},

    {"id": "fw-core", "summary": "Firmware shared by every board: identity, commands, RS485, WiFi/web portal, SD, OTA, PERF?.",
     "files": ["firmware/src/core/", "firmware/src/main.cpp", "firmware/src/modules/Module.h",
               "firmware/src/modules/ModuleFactory.*", "firmware/include/", "firmware/platformio.ini",
               "firmware/COMMANDS.md", "firmware/README.md", "firmware/CLAUDE.md",
               "firmware/save_fw_patch.py", "firmware/test/", "firmware/tools/"],
     "depends": ["fw-registry"]},

    {"id": "fw-web", "summary": "The board's own website (WebUI.h).",
     "files": ["firmware/src/web/"],
     "depends": ["fw-core"]},

    {"id": "fw-nong", "summary": "The nong (humanoid) module: servos, joints, poses.",
     "files": ["firmware/src/modules/nong/"],
     "depends": ["fw-core"]},

    {"id": "fw-lift", "summary": "The lift module: motor, encoder, limits, RGB, speaker.",
     "files": ["firmware/src/modules/lift/"],
     "depends": ["fw-core"]},

    {"id": "fw-cam", "summary": "The camera module (ESP32-CAM).",
     "files": ["firmware/src/modules/cam/"],
     "depends": ["fw-core"]},

    {"id": "fw-registry", "summary": "Registries: commands, modules, servos, amps, cameras, pins - and the generators that turn them into firmware tables.",
     "files": ["firmware/config/", "tools/gen_tables.py", "tools/registry.py"],
     "depends": []},

    {"id": "qc", "summary": "The QC suite, its gate and the promotion tool.",
     "files": ["qc/", "promote.py", ".promote-manifest.json", "tools/sabotage.py", "tools/land.py", "tools/snapshot.py",
               "tools/save_code_patch.py", "tools/watch_main.py"],
     "depends": []},

    {"id": "build", "summary": "Web asset and Studio builds.",
     "files": ["tools/build_web.py", "tools/build_studio.py", "tools/web_build.json",
               "tools/inspect_bundle.py"],
     "depends": []},

    {"id": "agents", "summary": "Plan, handoff and multi-AI tooling: plan.py, bridge, review panel, AI entry files.",
     "files": ["tools/plan.py", "tools/bridge.py", "tools/handover.py", "tools/ai_panel.py",
               "tools/local_panel.py", "tools/ai_brief.txt", "tools/next_batch.py",
               "tools/branch.py", "tools/make_app_branch.py", "tools/livedoc.py",
               "tools/reports.py", "tools/make_diary.py", "tools/systems.py",
               "CLAUDE.md", "AGENTS.md", "GEMINI.md", "README.md", "CHANGELOG.md",
               "NEXT_SESSION.*", "docs/systems.json"],
     "depends": []},

    {"id": "bench", "summary": "Scripts for real boards on the bench.",
     "files": ["tools/bench_*.py", "tools/rs485_test.py", "bench_*.py", "tools/make_app_shortcuts.py"],
     "depends": ["fw-core"]},

    {"id": "docs", "summary": "Plan, references, thesis sources, architecture notes, panel reports.",
     "listFiles": false,
     "files": ["docs/", "tools/build_thesis_bundle.py", "tools/build_complete_thesis_bundle.py"],
     "depends": []},

    {"id": "misc", "summary": "One-off scripts and experiments kept for reference, and any loose file at the top of the tree. Move a file out of here when it becomes part of a system.",
     "listFiles": false,
     "files": ["scient_test/", "auto_click/", "*"],
     "depends": []}
  ]
}
