{
  // OUTSIDE PROGRAMS THE RIG FOLLOWS. One entry each.
  //
  // Asked 2026-09-08: *make can add more app than this in the future, not only
  // face reconize, make it dynamic to easy to add.* So Reconize is the FIRST
  // ENTRY, not a special case. The second program is an entry here and no code.
  //
  // We never modify a partner. Reconize updates itself with
  // `git checkout --detach`, so anything we put in its folder is wiped or
  // blocks its update. We call it over HTTP and never open its database - it
  // runs without WAL, so a long read blocks its own writing.
  //
  // EVERY FIELD BELOW WAS READ OUT OF THEIR CODE ON 2026-09-10, not guessed.
  // The file and line is written beside each claim that could rot.

  "all-jao": {
    "name": "All-Jao Games",
    "open": "http://127.0.0.1:8080",
    "api": "http://127.0.0.1:8080",
    "health": "/",
    "folder": "E:/final_proj/mice/All-Jao-Games",
    "start": "python -m http.server 8080",
    "login": { "kind": "none", "path": "" },
    // A WIN GIVES A PRIZE (A47-6). The hub serves this folder read-only at
    // /play/all-jao/ and adds `inject` to its pages; the script reports each
    // new win below to /api/gacha/game. Their game keeps wins only in its own
    // localStorage, so the list is read out of their code (2026-10-22):
    // wheel script.js:8 + wheel-state.js:28, claw claw-game.js:8,308,
    // quiz quiz-game.js:8,138 (name + score), memory matching-game.js:84,94.
    // A new game is one more entry. A new origin: settings saved in their
    // own copy at :8080 are not seen here (Help says so).
    "play": {
      "page": "index.html",
      "inject": "/app/all-jao/link.js",
      "watch": [
        { "game": "wheel", "key": "all-jao-games.wheel.v2", "list": "logs", "id": "id", "result": "label", "defaultPerson": "@face" },
        { "game": "claw", "key": "all-jao-games.claw.v1", "list": "logs", "id": "id", "result": "label", "defaultPerson": "@face" },
        { "game": "quiz", "key": "all-jao-games.quiz.v1", "list": "players", "id": "id", "result": "score", "person": "name" },
        { "game": "memory", "text": "memory-status-text", "match": "ครบทุกคู่", "result": "won", "defaultPerson": "@face" }
      ]
    },
    "events": [
      {
        "kind": "status",
        "path": "/",
        "reports": ["game_state"],
        "hasCamera": false,
        "map": {}
      }
    ]
  },

  // Asked 2026-10-04: *add photo booth so it can open in the hub too*.
  // MAIN install (C:\Photobooth\Main, their README), never the Dummy dev copy.
  // Their own start script does every safety check (database revision, busy
  // ports, already running) and opens the browser to pair it as the booth
  // screen, so we run that script and never their backend directly.
  // stop-main.ps1 first: an unclean exit leaves data/run/main-processes.json
  // and run-main then refuses (measured 2026-10-04). stop-main only kills a
  // process whose pid, start time and exe all match, and drops dead ones.
  // Their backend sends X-Frame-Options: DENY (backend/src/photobooth/main.py:126),
  // so the hub opens it in a new tab - it cannot sit inside a hub page.
  "photobooth": {
    "name": "Photobooth",
    "open": "http://127.0.0.1:8121/booth",
    "admin": "http://127.0.0.1:8121/admin",
    "api": "http://127.0.0.1:8121",
    "health": "/api/health",
    "folder": "C:/Photobooth/Main/app",
    "refuseFolders": ["dummy"],
    "launch": [
      { "name": "booth", "cwd": "",
        "run": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "scripts\\stop-main.ps1", "&&",
                "powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "scripts\\run-main.ps1"],
        "check": "http://127.0.0.1:8121/api/health" }
    ],
    "login": { "kind": "none", "path": "" },
    "events": [
      { "kind": "status", "path": "/api/health", "reports": ["booth_state"],
        "hasCamera": false, "map": {} }
    ]
  },

  "reconize": {
    "name": "Reconize",
    "open": "http://localhost:5173",          // their React front end (::1 only)
    "api": "http://127.0.0.1:8000",           // their FastAPI
    "camera": "/recognition",                 // their live webcam page; Voice opens it
    "health": "/api/health",                  // main.py:182, needs no login

    // Voice's "Check who I am" sends ONE frame to `path`, which stores the
    // frame, a history row and an attendance row. So it is sent only when
    // `spec` (FastAPI's default self-description, not read from their code)
    // lists the `dontKeep` option there. Their own version has none: the one
    // that worked was a local patch, removed with their reset on 2026-09-29.
    "look": { "path": "/api/recognition/upload", "field": "photo",
              "dontKeep": "persist=false", "spec": "/openapi.json" },

    // WHAT WE ASKED THEM TO BUILD (brief "API ที่ขอจาก Face_Regonize",
    // 2026-10-09, system A13). Not in their version yet. Each route is used
    // only once THEIR /openapi.json lists it; until then everything works as
    // before. Names are the brief's PROPOSAL, so when theirs lands the fix is
    // an edit here - apps/faces/friend_api.py is the only reader.
    "asks": {
      "spec": "/openapi.json",
      // One JPEG in, who is where back, NOTHING stored (brief section 3).
      "look": { "path": "/api/look", "method": "post", "field": "photo",
                "form": { "source": "{camera}", "want": "faces" },
                "maxBytes": 2097152,
                "faces": "faces", "kept": "kept", "image": "image", "took": "took_ms",
                // What each refusal means to us. 429 = still on the last frame.
                "codes": { "400": "badImage", "401": "login", "413": "tooBig",
                           "429": "busy", "503": "loading" } },
      // Who is in front of one of THEIR cameras now (brief 3.5 item 4).
      "present": { "path": "/api/node/{node_id}/present", "method": "get",
                   "query": "seconds={seconds}", "maxSeconds": 30, "people": "people",
                   "facesNow": "faces_now", "unknownNow": "unknown_now" },
      // One person, in any of the answers above, the feed and history.
      "person": { "who": "name", "first": "first_name", "id": "participant_id",
                  "status": "status", "matched": "matched", "callAs": "call_as",
                  "title": "title", "lang": "language", "box": "box",
                  "score": "confidence", "lastSeen": "last_seen" }
    },
    // MAIN, never the Dummy copy (user 2026-09-16: *run only main not
    // dummy*). The hub refuses a folder whose path holds a word listed here.
    "folder": "E:/final_proj/mice/Face_Regonize",
    // The commit of theirs Mice was last checked against: the folder was put
    // back on it on 2026-09-29 (thread "Fix Face_Regonize git pull"). A newer
    // one is only REPORTED on the Reconize screen (A9) - nothing turns off.
    "testedWith": ["f27a9d5"],
    "refuseFolders": ["dummy"],

    // Their dev server listens on this PC only; this opens it to phones on the
    // same WiFi (their QR codes and /camera-node links). Their own vite proxy
    // forwards the API, so the API itself stays on this PC. Anyone on that
    // WiFi can then reach Reconize - their own login still guards it.
    "addArgs": { "npm run dev": "-- --host 0.0.0.0" },
    "start": "start.bat",

    // What "Open Reconize" starts, hidden. The commands are read from THEIR
    // `start` file on every press, because their app changes often; the list
    // below is only the fallback when that file cannot be read, and its
    // `check` addresses only a first guess until each part prints its own.
    // localhost, not 127.0.0.1: vite listens on ::1 only (measured 2026-09-16).
    "launch": [
      { "name": "face engine", "cwd": "backend",
        "run": [".venv/Scripts/python.exe", "-m", "uvicorn", "app.main:app",
                "--port", "8000"],
        "check": "http://127.0.0.1:8000/api/health" },
      { "name": "screen", "cwd": "frontend",
        "run": ["cmd", "/c", "npm run dev"],
        "check": "http://localhost:5173/" }
    ],

    // One person, seen twice, is one arrival. A central-inference match
    // publishes under the real camera (their api/nodes.py:332-338) and the
    // background persistence publishes it again tagged "kiosk"
    // (api/recognition.py:139-145), so the same face arrives twice within a
    // second or two. Strangers are never merged - they have no identity.
    "dedupeSeconds": 20,

    // Labels that arrive in the camera field but are NOT places. Their
    // kiosk publishes node_id as the literal string "kiosk" and their own
    // comment says the kiosk never registers itself as a node. Greeting
    // somebody "at" it would put them at a door that does not exist.
    "notACamera": ["kiosk"],

    // api/auth.py:12 mounts the router at /api/auth, so login is /api/auth/login.
    "login": { "kind": "jwt", "path": "/api/auth/login", "expires_min": 480 },

    // WHERE EVENTS COME FROM, and - just as important - what each source can
    // NOT tell us. The two sources have opposite holes, and pretending
    // otherwise is how the rig would greet the wrong person at the wrong door.
    "events": [
      {
        // api/nodes.py:482 mounts the websocket, api/nodes.py:67 the /api/node
        // prefix. The body is exactly the six fields mapped below
        // (api/nodes.py:332-338).
        "kind": "ws",
        // include=presence (657f396): strangers arriving and leaving too,
        // as {"type": "presence", node_id, status "unknown", faces, unknown}.
        // An older version ignores the extra word.
        "path": "/api/node/events-feed?token={token}&include=presence",

        // KNOWN FACES ONLY. Both publishers guard it: api/nodes.py:331 sends
        // only when status == matched, and api/recognition.py:130 only when
        // person_id is set. A stranger never appears here at all.
        "reports": ["known"],
        "hasCamera": true,
        "map": { "who": "name", "id": "participant_id", "camera": "node_id",
                 "when": "at", "repeat": "checkin",
                 // Asked for (brief 3.5 items 1-3), read only when present: a
                 // stranger event {"status": "unknown", "faces": 1} and the
                 // name a person likes to be called.
                 "status": "status", "faces": "faces", "unknown": "unknown",
                 "callAs": "call_as",
                 "title": "title", "lang": "language" }
      },
      {
        // Start at latest_seq once, then consume committed rows oldest first.
        // Null legacy sequences are not replayed on watcher startup.
        "kind": "poll",
        "path": "/api/history?page_size=100&page={page}",
        "items": "items",
        "cursor": {"path": "/api/history?page_size=100&after_seq={after_seq}",
                   "latest": "latest_seq", "next": "next_after_seq", "seq": "seq"},
        // node_id is provenance. Old or delayed rows count but cannot greet.
        "reports": ["known", "unknown"],
        "hasCamera": true,
        "map": { "who": "name", "id": "participant_id",
                 "when": "detected_at", "status": "status", "row": "id",
                 "camera": "node_id", "origin": "source", "callAs": "call_as" }
      }
    ],

    // Their count is the truth, ours the fallback (api/reports.py:16, field at
    // :51). READ WHAT IT COUNTS BEFORE BUILDING A MILESTONE ON IT: it is
    // `count(distinct Attendance.person_id)` since midnight (api/reports.py:25)
    // - distinct RECOGNISED people today. A stranger has no Attendance row, so
    // strangers are not in this number, and one person seen ten times is one.
    // A rule that says *100 people arrived* therefore means 100 known people.
    "count": { "path": "/api/reports/dashboard", "field": "detected_today",
               "means": "distinct recognised people since midnight" }
  }
}
