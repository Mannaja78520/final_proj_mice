{
  // Double-click starters that are not "one app" (those come from each app's alonePort, tools/make_launchers.py).
  // Each entry: the file name (plain words) and its lines. Paths use forward slashes: the folder is found from the
  // .bat's own location, nothing is hardcoded. Regenerate: python tools/make_launchers.py
  "Start PC Assistant.bat": [
    "@echo off",
    "title MICE - Start PC Assistant",
    "rem Starts the PC assistant (the Claude remote-control session for this folder) now, and turns on the small",
    "rem automatic check that keeps it running (every 3 minutes, until the PC restarts or shuts down). Safe to open twice.",
    "set \"REPO=%~dp0../..\"",
    "echo.",
    "echo  Starting the PC assistant...",
    "python \"%REPO%/tools/pc_assistant_ensure.py\" --on >nul 2>&1",
    "powershell -NoProfile -ExecutionPolicy Bypass -File \"%REPO%/tools/rc_watchdog_install.ps1\" -NoStart >nul 2>&1",
    "if errorlevel 1 (",
    "  echo  Could not turn on the automatic check. The assistant will still be started now,",
    "  echo  but it will not restart by itself if it stops.",
    ") else (",
    "  echo  The automatic check is on: it looks every 3 minutes, until the PC is restarted or shut down.",
    ")",
    "powershell -NoProfile -ExecutionPolicy Bypass -File \"%REPO%/tools/rc_watchdog.ps1\" >nul 2>&1",
    "python \"%REPO%/tools/ai_watch.py\" start >nul 2>&1",
    "ping -n 9 127.0.0.1 >nul",
    "for /f \"delims=\" %%S in ('powershell -NoProfile -ExecutionPolicy Bypass -File \"%REPO%/tools/rc_watchdog.ps1\" -Status') do set \"STATE=%%S\"",
    "echo.",
    "echo  The PC assistant is: %STATE%",
    "echo  If a usage limit is reached, the work is handed on automatically and picked up again after the reset.",
    "echo  After you restart or shut down the PC, just send any message to Claude, GPT or Gemini: it continues the work",
    "echo  and turns this on again by itself. To turn it off for good, open \"Stop PC Assistant\".",
    "echo.",
    "pause"
  ],
  "Stop PC Assistant.bat": [
    "@echo off",
    "title MICE - Stop PC Assistant",
    "rem Turns off the automatic check and stops the PC assistant session (only that one). Safe to open twice.",
    "set \"REPO=%~dp0../..\"",
    "echo.",
    "python \"%REPO%/tools/pc_assistant_ensure.py\" --off >nul 2>&1",
    "echo  Turning off the automatic check...",
    "powershell -NoProfile -ExecutionPolicy Bypass -File \"%REPO%/tools/rc_watchdog_uninstall.ps1\" >nul 2>&1",
    "echo  Stopping the PC assistant...",
    "powershell -NoProfile -ExecutionPolicy Bypass -File \"%REPO%/tools/rc_watchdog.ps1\" -StopSession >nul 2>&1",
    "echo.",
    "python \"%REPO%/tools/ai_watch.py\" stop >nul 2>&1",
    "echo  Done. The PC assistant will not start by itself any more, and no AI will turn it on again",
    "echo  until you open \"Start PC Assistant\".",
    "echo  To start it again, open \"Start PC Assistant\".",
    "echo.",
    "pause"
  ],
  "Reset Hub Password.bat": [
    "@echo off",
    "title MICE - Reset Hub Password",
    "rem Forgot the hub password? Run this ON THE HUB PC. It edits the local login file directly, so it only works on this PC,",
    "rem never over the network. It puts the shipped logins back on the shipped password; the hub asks for a new one at the next login.",
    "set \"REPO=%~dp0../..\"",
    "echo.",
    "python \"%REPO%/tools/hub_reset_password.py\"",
    "echo.",
    "pause"
  ]
}
