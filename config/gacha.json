{
  // PRIZE MACHINES (gachapon) - A47-2. Edited from the Prize machines page;
  // every list here is data, so a new machine, kind or webhook is one entry.
  //
  // machines: one per gacha board.
  //   id      this file's own name for it (used by "near" and the API)
  //   module  the board's name (SET NAME / module page); found on any route
  //   dev     optional fixed address (wifi:<ip> or usb:<port>[:<bus id>])
  //   label   what people read and hear ("the machine by the stage")
  //   item    the kind it holds (a key of "items")
  //   place   where it stands, said when a person is sent there
  //   near    machines next to it: tried first when this one is empty
  //   enabled false = never chosen
  "machines": [],
  // kinds of prize: key -> {label}
  "items": {},
  // the event every machine is told about (Start / Close / New event)
  "event": {"name": "", "open": true},
  // rules: kept on the page; a Google Sheet can hold them too (A47-15,
  // main_python/gacha_sheet.py). sheet_link = the pasted sheet address;
  // sheet_way auto | script | service | link (read only); sheet_write_url = the
  // sheet's Apps Script web app (apps/gacha/sheet_script.gs); sheet_key_file =
  // a service account key, default .local/gacha/google_service.json (never git);
  // sheet_tabs {items, people, log} renames the tabs; sheet_auto_push writes
  // every saved rule, sheet_log adds a row per prize. sheet_*_csv: the older
  // published-CSV links, used only when no sheet_link is set.
  "rules": {"source": "local", "sheet_items_csv": "", "sheet_people_csv": "",
            "sheet_write_url": "", "sheet_link": "", "sheet_way": "auto",
            "sheet_key_file": "", "sheet_tabs": {}, "sheet_auto_push": false,
            "sheet_log": false},
  // other apps told about: dispensed, empty, out, low, refused, jam
  // (lists of http addresses; each gets a JSON POST, see docs/gacha/README.md)
  "webhooks": {},
  // "few balls left" from this many
  "low_stock": 2,
  // seconds to wait for a board to say the prize fell
  "wait_s": 20,
  // seconds to wait for a machine still turning for the last prize
  "busy_wait_s": 8,
  // games that give a prize (A47-6): first row that fits wins.
  //   game    a game name from config/partners.json "play.watch" (empty = any)
  //   result  pattern on what the game reports (prize name, quiz score, "won")
  //   item    the kind;  machine  optional;  person  who, when the game names nobody
  "games": [],
  // words the robot says; empty = the built-in Thai words in gacha.py
  "messages": {}
}
