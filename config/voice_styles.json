{
  // SPEAKING MANNER (จริต) - how a line is said, not what is said (A45-25).
  // User 2026-10-21: closer to a person, polite / friendly / playful / อ้อน,
  // with emotion, and ทำนองเสนาะ for poems. A new manner is one entry here.
  //
  // Which manner: the /say request's `style`, else the scenario's `style`,
  // else voice.json tts.style. Empty = none = exactly as before A45-25.
  //
  // What each speaking service can really do is its speak job's `styles` in
  // voice_providers.json - never assumed here:
  //   instruct  the service is TOLD the manner in words (Gemini TTS: Thai is
  //             supported and it follows a style line, per Google's docs
  //             2026-10-21). Real expression - but needs a key, and was NOT
  //             heard on this PC yet (keys deferred by the user).
  //   prosody   only speed and pitch move (Edge, Azure Thai voices). That is
  //             a lighter or slower voice, NOT emotion, and NOT ทำนองเสนาะ.
  //   emotion   the service is told a feeling by name (`emotion` below):
  //             this PC's Thai voice with feeling (apps/voice/tts_spark).
  //             Words checked by hearing them back (0.87-1.0 alike, 2026-10-
  //             21); the feeling itself only a human ear can judge - two
  //             automatic emotion judges were no better than chance.
  //   none      the manner cannot be applied (this PC's Windows voice).
  // The words of a line never change. Only a manner's `answer` (opt-in) asks
  // the MODEL to word NEW answers its way - ending, self-word, a style line;
  // with `answer.saved` the ending and self-word of saved answers follow too.
  // Read-aloud always stays exactly as written.
  "styles": {
    "polite": {
      "says": "สุภาพ (Polite)",
      "instruct": "polite, calm and respectful, like a courteous host",
      "prosody": {"rate": -4, "pitch": 0},
      "emotion": "neutral"
    },
    "friendly": {
      "says": "เป็นกันเอง (Friendly)",
      "instruct": "warm, casual and friendly, smiling while speaking",
      "prosody": {"rate": 0, "pitch": 3},
      "emotion": "happy"
    },
    "playful": {
      "says": "ขี้เล่น (Playful)",
      "instruct": "playful and cheerful, light and bouncy, a little teasing",
      "prosody": {"rate": 3, "pitch": 6},
      "emotion": "happy",
      // The feeling voice knows one happy: playful and friendly sound the same
      // there (same line = same sound, measured 2026-10-21). Edge differs.
      "emotionNote": "the same happy feeling as friendly on this voice"
    },
    "coaxing": {
      "says": "อ้อน (Sweet, coaxing)",
      "instruct": "soft, sweet and endearing, gently coaxing, a little pleading",
      "prosody": {"rate": -8, "pitch": 4},
      // THAI-SER has no "sweet": a soft sad tone is the nearest it knows.
      "emotion": "sad",
      "emotionNote": "the nearest feeling it knows is a soft, sad tone"
    },
    // User 2026-10-21: *ขอจริตแบบฟาดๆด้วยหน่อยแบบเจ๊* - sassy big sister: quick,
    // cheeky, a bit dramatic, warm underneath. Never insults a visitor.
    "sassy": {
      "says": "ฟาดๆ แบบเจ๊ (Sassy)",
      "instruct": "sassy and sharp like a confident Thai big sister, quick, cheeky and a little dramatic, but warm underneath and never rude",
      "prosody": {"rate": 4, "pitch": 4},
      "emotion": "angry",
      "emotionNote": "a sharp, punchy tone (THAI-SER has no sassy: angry is the nearest); the words do the rest",
      "answer": {
        "particle": "ค่ะ", "pronoun": "เจ๊",
        // saved answers too: only their ending and self-word change, so a
        // เจ๊ voice never ends a saved answer with ครับ
        "saved": true,
        "wording": {
          "th": "พูดแบบเจ๊ ฟาดๆ มั่นใจ ปากไวแต่ใจดี แซวเบาๆ ได้ เช่น ว้าย นี่นะ บอกเลย แต่ต้องสุภาพกับแขกเสมอ ห้ามดูถูก ห้ามหยาบคาย และยังต้องให้ข้อมูลที่ถูกต้อง",
          "en": "Speak like a sassy, confident big sister: quick, cheeky, a little dramatic, but kind; never insult the visitor and still give the right information.",
          "ja": "自信たっぷりで少し毒舌なお姉さん風に、でも優しく。相手を侮辱せず、正しい情報を伝えること。",
          "zh": "像一个自信、嘴快又有点夸张的大姐那样说话，但心地善良；绝不侮辱客人，并且要给出正确的信息。"
        }
      }
    },
    "recite": {
      "says": "ทำนองเสนาะ (Poem recital)",
      "instruct": "recite this Thai poem in traditional Thai melodic recitation (ทำนองเสนาะ): slow, with long held vowels, a rising and falling tune in each line, and a pause between lines",
      "prosody": {"rate": -18, "pitch": 0},
      "emotion": "neutral",
      "emotionNote": "a calm reading, not a real ทำนองเสนาะ tune",
      // With prosody only this is a slow reading, never a tune. Said so on
      // the Voice page instead of pretending.
      "prosodyNote": "slow reading only, not a real ทำนองเสนาะ tune"
    }
  },
  // The pick marked "recommended" on the Voice page (user 2026-10-21: do not
  // wait for me - pick one). Friendly fits a robot greeting guests. It is
  // NOT applied by itself: the PC's voice.json tts.style is the choice, set
  // from the Voice page; every event can pick its own.
  "recommended": "friendly",
  // Services tried FIRST while a manner is on, when they are installed; the
  // chosen speak order (voice.json use.speak) follows as the backup, so the
  // line is never left unsaid. A manner may carry its own "prefer" (that one
  // wins), e.g. "prefer": ["feeling"] for the Thai voice with feeling.
  // EMPTY since 2026-10-22 (A45-26, user: *เสียงยังดูเป็น AI เกินไป ... รวบเกิน
  // ฟังไม่รู้เรื่อง ... ฟังชัด*): heard back by the Thai whisper, 6 lines,
  // Edge Premwadee at -10% speed got 2.9% letters wrong and every last word;
  // the feeling voice 6.1% at its clearest (temperature 0.3), 11-12% before,
  // and it speaks faster. Clarity wins over feeling. Samples + numbers:
  // scratch/voice-clear-2026-10-22 (PC only).
  "prefer": [],
  // Manner speed steps were lowered 2026-10-22 (friendly 3->0, playful 8->3,
  // sassy 10->4): a faster line is the one heard as run together.
  // Steps the speed and pitch may reach in total (Edge refuses wild values).
  "limits": {"rate": [-50, 50], "pitch": [-30, 30]}
}
