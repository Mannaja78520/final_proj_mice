# ---- Build output (regenerated, never committed) ----

# PlatformIO: build products + downloaded libraries (~230 MB)
.pio/
firmware/.pio/

# Generated firmware tables and web page (tools/gen_tables.py writes them per
# build, one binary per module type — the source is config/*.json and
# src/web/WebUI.h). This copy is the all-types one the tools and QC read.
firmware/generated/

# CMake / ament build tree
build/
firmware/build/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Editor / machine specific ----
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.idea/

# Claude Code local permission overrides (per machine)
.claude/settings.local.json

# ---- OS junk ----
Thumbs.db
desktop.ini
.DS_Store

# QC scratch (browser profiles / dom dumps are recreated each run)
qc/_profile_*
qc/_boot_dom.html*
qc/**/__pycache__/

# staging workspaces (promote.py --staging DIR) — working copies, never
# committed. The glob matters: a second tree for a different job is normal
# (.staging-integral), and the bare name would have committed the whole of it.
.staging*/

# this machine's Claude Code settings and permissions, not source
.claude/settings.local.json

# ---- Secrets. These belong to ONE machine and must never travel ----
# hub_auth.json is the hub password as a salted hash; hub_password.txt is the
# same password in plain text, written so nobody gets locked out of their own
# robot. Both are per-machine, both are already in promote.py's SKIP_FILES,
# and neither may reach a commit — history keeps what you delete later.
main_python/hub_auth.json
main_python/hub_auth.json.*
main_python/hub_password.txt
.qc-receipt.json

# External partner game assets (code stays in All-Jao-Games repo, launcher only)
apps/jao/*.js
apps/jao/*.css

# ---- Local Snapshot Backups & Patches ----
patches_code/
firmware/patches/
nong/main_python_set_nong/patches/
*.bak
*.bak.json

# ---- Local Logs, Scratch & Test Artifacts ----
*.log
scratch/
scratch.js
test.mp3
test_tts.wav
pwned_*.json
*_cookies.txt
cookies.txt
a.json
b.json
a.txt
b.txt
dist/thesis_references_bundle/
dist/*.zip
dist/*.json


